rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Default Deny (Catch-All)
    // ===============================================================
    // Unmapped collections are blocked by default.
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role == 'admin') ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email.matches('(?i)^joaoribasdossantos@gmail\\.com$')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isEditor() {
      return isAuthenticated() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor')
      );
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Data Validation Schemas
    // ===============================================================

    function isValidBackup(data) {
      return hasOnlyAllowedFields(['client', 'title', 'status', 'category', 'timestamp', 'responsible', 'technicalAnalysis', 'actionPlan', 'backupType', 'criticality', 'rootCause', 'impact', 'treatmentStatus', 'actionDeadline', 'recurrence', 'responsibleTreatment']) &&
             data.client is string && data.client.size() > 0 && data.client.size() < 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.status in ["success", "warning", "failed"] &&
             data.category is string && data.category.size() > 0 && data.category.size() < 100 &&
             data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() < 50 &&
             data.responsible is string && data.responsible.size() > 0 && data.responsible.size() < 100 &&
             (!('technicalAnalysis' in data) || data.technicalAnalysis == null || (data.technicalAnalysis is string && data.technicalAnalysis.size() < 5000)) &&
             (!('actionPlan' in data) || data.actionPlan == null || (data.actionPlan is string && data.actionPlan.size() < 5000)) &&
             (!('backupType' in data) || data.backupType == null || (data.backupType is string && data.backupType.size() < 100)) &&
             (!('criticality' in data) || data.criticality == null || data.criticality in ["low", "medium", "high", "critical"]) &&
             (!('rootCause' in data) || data.rootCause == null || data.rootCause in ["network", "storage", "credential", "service", "window", "human", "other"]) &&
             (!('impact' in data) || data.impact == null || data.impact in ["low", "medium", "high"]) &&
             (!('treatmentStatus' in data) || data.treatmentStatus == null || data.treatmentStatus in ["pending", "analyzing", "mitigated", "resolved"]) &&
             (!('actionDeadline' in data) || data.actionDeadline == null || data.actionDeadline is string) &&
             (!('recurrence' in data) || data.recurrence == null || data.recurrence is bool) &&
             (!('responsibleTreatment' in data) || data.responsibleTreatment == null || data.responsibleTreatment is string);
    }

    function isValidClient(data) {
      return hasOnlyAllowedFields(['name', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() < 50;
    }

    function isValidDestination(data) {
      return hasOnlyAllowedFields(['name', 'client', 'freeSpaceTB', 'usedSpaceTB', 'totalSpaceTB', 'savingsPercent', 'savingsTB', 'backupsCount', 'location']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.client is string && data.client.size() > 0 && data.client.size() < 100 &&
             data.freeSpaceTB is number && data.freeSpaceTB >= 0 &&
             data.usedSpaceTB is number && data.usedSpaceTB >= 0 &&
             data.totalSpaceTB is number && data.totalSpaceTB >= 0 &&
             data.savingsPercent is number && data.savingsPercent >= 0 && data.savingsPercent <= 100 &&
             data.savingsTB is number && data.savingsTB >= 0 &&
             data.backupsCount is number && data.backupsCount >= 0 &&
             data.location in ["Local", "S3", "Cloud"];
    }

    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'email', 'role', 'xp', 'level', 'displayName', 'photoURL', 'createdAt']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 50 &&
             data.email is string && data.email.size() > 0 && data.email.size() < 150 &&
             data.role in ["admin", "editor", "viewer"] &&
             (!('xp' in data) || (data.xp is number && data.xp >= 0)) &&
             (!('level' in data) || (data.level is string && data.level.size() < 100)) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() < 500)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() < 50));
    }

    function isValidXPHistory(data) {
      return hasOnlyAllowedFields(['userId', 'amount', 'reason', 'timestamp']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.amount is number && data.amount >= -100 && data.amount <= 100 &&
             data.reason is string && data.reason.size() > 0 && data.reason.size() < 200 &&
             data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() < 50;
    }

    function isValidBackupType(data) {
      return hasOnlyAllowedFields(['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100;
    }

    function isValidTask(data) {
      return hasOnlyAllowedFields(['title', 'description', 'completed', 'createdAt', 'updatedAt', 'userId', 'dueDate', 'slaDate', 'important', 'tags', 'status', 'type', 'priority', 'duration', 'relatedBackupId', 'relatedClient', 'relatedRecordTitle', 'owner', 'blockedReason', 'source', 'recurrence', 'checklist', 'notes', 'isGolden']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 500 &&
             data.completed is bool &&
             data.createdAt is string &&
             data.userId is string && data.userId == request.auth.uid &&
             data.status in ["inbox", "today", "doing", "waiting", "blocked", "done"] &&
             data.type in ["rotina", "incidente", "plano_de_acao", "follow_up", "apresentacao", "melhoria"] &&
             data.priority in ["low", "medium", "high", "critical"] &&
             data.owner is string &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() < 2000)) &&
             (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() < 5000)) &&
             (!('isGolden' in data) || data.isGolden == null || data.isGolden is bool) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is string) &&
             (!('dueDate' in data) || data.dueDate == null || data.dueDate is string) &&
             (!('slaDate' in data) || data.slaDate == null || data.slaDate is string) &&
             (!('important' in data) || data.important == null || data.important is bool) &&
             (!('tags' in data) || data.tags == null || (data.tags is list && data.tags.size() <= 20)) &&
             (!('duration' in data) || data.duration == null || data.duration is number) &&
             (!('relatedBackupId' in data) || data.relatedBackupId == null || data.relatedBackupId is string) &&
             (!('relatedClient' in data) || data.relatedClient == null || data.relatedClient is string) &&
             (!('relatedRecordTitle' in data) || data.relatedRecordTitle == null || data.relatedRecordTitle is string) &&
             (!('blockedReason' in data) || data.blockedReason == null || (data.blockedReason is string && data.blockedReason.size() < 1000)) &&
             (!('source' in data) || data.source == null || data.source in ["manual", "incident", "recurrent", "automatic"]) &&
             (!('recurrence' in data) || data.recurrence == null || (data.recurrence is map && data.recurrence.type in ["daily", "business", "weekly", "monthly", "fridays", "none"])) &&
             (!('checklist' in data) || data.checklist == null || data.checklist is list);
    }

    function isValidAuditLog(data) {
      return hasOnlyAllowedFields(['userId', 'userName', 'action', 'details', 'timestamp']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() < 150 &&
             data.action is string && data.action.size() > 0 && data.action.size() < 100 &&
             data.details is string && data.details.size() > 0 && data.details.size() < 2000 &&
             data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() < 50;
    }

    function isValidActivity(data) {
      return hasOnlyAllowedFields(['userId', 'userName', 'userPhoto', 'action', 'details', 'timestamp', 'clientName', 'clientId', 'status', 'metadata']) &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() < 150 &&
             data.action is string && data.action.size() > 0 && data.action.size() < 200 &&
             data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() < 50 &&
             data.status in ["success", "warning", "failed", "info"] &&
             (!('userId' in data) || data.userId == null || (data.userId is string && data.userId == request.auth.uid)) &&
             (!('userPhoto' in data) || data.userPhoto == null || (data.userPhoto is string && data.userPhoto.size() < 1000)) &&
             (!('details' in data) || data.details == null || (data.details is string && data.details.size() < 2000)) &&
             (!('clientName' in data) || data.clientName == null || (data.clientName is string && data.clientName.size() < 200)) &&
             (!('clientId' in data) || data.clientId == null || (data.clientId is string && data.clientId.size() < 100)) &&
             (!('metadata' in data) || data.metadata == null || data.metadata is map);
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // Connectivity Test
    match /test/{docId} {
      allow read: if isAuthenticated();
    }

    // Collection: backups
    match /backups/{backupId} {
      allow read: if isAuthenticated() && isValidId(backupId);
      allow create, update: if isAuthenticated() && isValidId(backupId) && isEditor() && isValidBackup(request.resource.data);
      allow delete: if isAuthenticated() && isValidId(backupId) && isAdmin();
    }

    // Collection: clients
    match /clients/{clientId} {
      allow read: if isAuthenticated() && isValidId(clientId);
      allow create, update: if isAuthenticated() && isValidId(clientId) && isAdmin() && isValidClient(request.resource.data);
      allow delete: if isAuthenticated() && isValidId(clientId) && isAdmin();
    }

    // Collection: destinations
    match /destinations/{destinationId} {
      allow read: if isAuthenticated() && isValidId(destinationId);
      allow create, update: if isAuthenticated() && isValidId(destinationId) && isEditor() && isValidDestination(request.resource.data);
      allow delete: if isAuthenticated() && isValidId(destinationId) && isAdmin();
    }

    // Collection: users
    match /users/{userId} {
      allow read: if isAuthenticated() && isValidId(userId);
      allow create: if isAuthenticated() && isValidId(userId) && isValidUser(request.resource.data) && (
        isAdmin() || 
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email.matches('(?i)^joaoribasdossantos@gmail\\.com$')) ||
        (isOwner(userId) && (
          request.resource.data.role == 'viewer' || 
          isAdmin() ||
          (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email.matches('(?i)^joaoribasdossantos@gmail\\.com$'))
        ))
      );
      allow update: if isAuthenticated() && isValidId(userId) && isValidUser(request.resource.data) && (
        isAdmin() || 
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email.matches('(?i)^joaoribasdossantos@gmail\\.com$')) ||
        (isOwner(userId) && 
         request.resource.data.role == resource.data.role &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.email == resource.data.email &&
         (!('xp' in request.resource.data) || 
          (request.resource.data.xp == 0 && (request.resource.data.level == 'Operador de Snapshot L1' || request.resource.data.level == 'Padawan do Backup')) ||
          (!('xp' in resource.data) && request.resource.data.xp <= 100) || 
          ('xp' in resource.data && request.resource.data.xp - resource.data.xp <= 100 && request.resource.data.xp - resource.data.xp >= -100)))
      );
      allow delete: if isAuthenticated() && isValidId(userId) && isAdmin();
    }

    // Collection: xp_history
    match /xp_history/{historyId} {
      allow read: if isAuthenticated() && isValidId(historyId) && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidId(historyId) && request.resource.data.userId == request.auth.uid && isValidXPHistory(request.resource.data);
      allow delete: if isAuthenticated() && isValidId(historyId) && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && isValidId(historyId) && isAdmin();
    }

    // Collection: backup_types
    match /backup_types/{typeId} {
      allow read: if isAuthenticated() && isValidId(typeId);
      allow create, update: if isAuthenticated() && isValidId(typeId) && isAdmin() && isValidBackupType(request.resource.data);
      allow delete: if isAuthenticated() && isValidId(typeId) && isAdmin();
    }

    // Collection: tasks
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && isValidId(taskId) && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidId(taskId) && request.resource.data.userId == request.auth.uid && isValidTask(request.resource.data);
      allow update: if isAuthenticated() && isValidId(taskId) && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidTask(request.resource.data);
      allow delete: if isAuthenticated() && isValidId(taskId) && resource.data.userId == request.auth.uid;
    }

    // Collection: audit_logs
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && isValidId(logId) && isAdmin();
      allow create: if isAuthenticated() && isValidId(logId) && request.resource.data.userId == request.auth.uid && isValidAuditLog(request.resource.data);
      allow update, delete: if isAuthenticated() && isValidId(logId) && isAdmin();
    }

    // Collection: activities
    match /activities/{activityId} {
      allow read: if isAuthenticated() && isValidId(activityId);
      allow create: if isAuthenticated() && isValidId(activityId) && isValidActivity(request.resource.data);
      allow update, delete: if isAuthenticated() && isValidId(activityId) && isAdmin();
    }

    // ===============================================================
    // Unmapped Catch-All Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
